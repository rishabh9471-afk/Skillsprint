# Copy this file to `.env` for local development.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# Never commit the real .env file (it is in .gitignore).

# --- AI (free) -------------------------------------------------------------
# Google AI Studio → Get API key. Primary grader.
GEMINI_API_KEY=
# Optional: the Gemini model. Default always points to the latest Flash model.
GEMINI_MODEL=gemini-flash-latest
# Groq console → API Keys. Fallback when Gemini is busy or down.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Database (free) -------------------------------------------------------
# Supabase → Project Settings → API. Use the *service_role* key (server only).
# Leave empty locally to use a temporary in-memory store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- App settings ----------------------------------------------------------
# Any long random string. Signs session tokens so scores/XP can't be faked.
SESSION_SECRET=
# Password for /dashboard.
DASHBOARD_PASSWORD=
# New scenarios each visitor can start per day (IST).
DAILY_SCENARIO_LIMIT=3
# Max AI requests per day across all users (keep below Gemini's free quota).
GLOBAL_DAILY_AI_CAP=1200

# Local testing only: fake AI responses, no keys needed. Never set on Vercel.
MOCK_AI=false
